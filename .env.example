# HASHIRU v2. Copy to .env and run with: uv run --env-file .env hashiru serve (or ask "...", or chat)
# Models are LiteLLM strings: ollama_chat/... and ollama/... are local (they cost memory),
# anything else is cloud (it costs money and needs that provider's key below).

# Local only, no keys (needs Ollama with the model pulled: ollama pull qwen3.5:4b)
CEO_MODEL=ollama_chat/qwen3.5:4b
MODELS=ollama_chat/qwen3.5:4b

# Mixed: a cloud CEO that can hire local or cloud agents
# CEO_MODEL=gemini/gemini-2.5-flash
# MODELS=ollama_chat/qwen3.5:4b,gemini/gemini-2.5-flash
# GEMINI_API_KEY=

BUDGET_USD=0.50     # the CEO's pool for one session
MAX_USD=2.00        # hard cap on real API spend per process
# OLLAMA_URL=http://127.0.0.1:11434
# PORT=9200
# HASHIRU_PRICES=prices.json   # LiteLLM price entries for cloud models its map lacks
# HASHIRU_TOOL_CREATION=true   # let managers write tools that run as code on this machine (not a sandbox)

# Serving (uv run --env-file .env hashiru serve)
# HASHIRU_API_KEY=             # clients send it as "Authorization: Bearer ..."; required to listen beyond loopback
# HASHIRU_PUBLIC_URL=          # the address clients use, for the A2A Agent Card, e.g. https://you.example
